{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"],
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"strict": false
	},
	"include": ["src/host/**/*.ts"]
}
