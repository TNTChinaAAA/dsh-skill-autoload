{
  "name": "dsh-skill-autoload",
  "displayName": "DSH 技能常驻",
  "description": "DSH（DeepSeek Harness）技能常驻插件：左侧栏入口 + 独立管理浮层，勾选即把技能正文常驻到 AGENTS.md 标记区块，靠 dsh-agent-instructions 的窗口检测「有就不用、没有就补」。要求 DSH ≥ 0.2.2-rc.1。",
  "version": "0.1.0",
  "author": "TNTChinaAAA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNTChinaAAA/dsh-skill-autoload.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "autoload",
    "agents-md"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/host/index.mjs",
  "types": "lib/host/index.d.mts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/host/index.d.mts",
      "default": "./lib/host/index.mjs"
    },
    "./client": {
      "types": "./lib/client/client.d.ts",
      "default": "./lib/client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-alpha.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.25.0",
    "react": "^18.2.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
