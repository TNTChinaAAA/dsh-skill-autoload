{
  "name": "dsh-skill-autoload",
  "displayName": "DSH 技能常驻",
  "description": "DSH（DeepSeek Harness）技能常驻插件：左侧栏入口 + 独立管理浮层，勾选即把技能正文常驻到 AGENTS.md 标记区块。零运行时依赖（只用 node: 内置模块与 DSH 提供的 React）。要求 DSH ≥ 0.2.2-rc.1。",
  "version": "0.1.0",
  "author": "TNTChinaAAA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNTChinaAAA/dsh-skill-autoload.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "skill",
    "autoload",
    "agents-md"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-rc.5 || ^0.2.2-rc.1"
  },
  "main": "lib/host/index.mjs",
  "types": "lib/host/index.d.mts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json"
  },
  "exports": {
    ".": {
      "types": "./lib/host/index.d.mts",
      "default": "./lib/host/index.mjs"
    },
    "./client": {
      "types": "./lib/client/client.d.ts",
      "default": "./lib/client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
